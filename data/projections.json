    {
      "id": "PROJ-LAB-ROLE-CURVE-001",
      "childKey": "lab.roleCurve",
      "value": {
        "attack": [1, 2, 2, 3, 4],
        "defense": [1, 2, 2, 3, 4],
        "healing": [1, 1, 2, 2, 3],
        "logistics": [1, 1, 1, 2, 2],
        "movement": [1, 1, 1, 1, 1],
        "recon": [1, 1, 1, 1, 1]
      },
      "parents": ["balance.effect_budget.default_amount_by_role"],
      "policy": "sqrt_budget_scalar_projection_v1",
      "scope": "wenzhen_web_lab",
      "rationale": "RUL-2026-09-26-001 Q1/Q2（adjudicated_via RESEARCH-REQUEST-2026-09-26-lab-role-curve-projection）：LAB role amounts are a one-way projection of the WORLD default role curves. WORLD rank power budget is projected to LAB at 1/20, while default primary effect scalars follow sqrt(Budget); therefore scalar amounts project by sqrt(1/20) = 1/sqrt(20). For each role and rank: raw = world_amount / sqrt(20); lab_amount = max(1, ceil(raw)). The projection never writes back to WORLD. LAB PP weights are validation/pricing weights applied after amount projection and are not an independent source for role curves. Movement and recon use the same formula; their flat LAB amounts are an intentional consequence of small-integer projection, with higher-rank differentiation expected from effect semantics rather than hidden scalar inflation. 旧基线 attack [2,3,4,5,6] 仅存于迁移前后报告（git 历史 ≤a1bff043），不参与任何 Runtime 消费。真实消费者=tools/build_data.mjs（写入生成物 DATA.projections.role_curve_lab，check_projection 按 parent 复算 30 值断言）",
      "authority": "LAB_ONLY",
      "validation": { "type": "formula_projection", "formula": "max(1, ceil(world_amount / sqrt(20)))", "path": "projections.role_curve_lab" },
      "forbidWriteBack": true,
      "sourceRuling": "RUL-2026-09-26-001"
    },
